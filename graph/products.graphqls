type PackagingUnit {
  unitId: ID!
  factor: Float!
  costPrice: Float!
  retailPrice: Float!
  wholesalePrice: Float!
  wholesaleMinQty: Int!
}

input PackagingUnitInput {
  unitId: ID!
  factor: Float!
  costPrice: Float!
  retailPrice: Float!
  wholesalePrice: Float!
  wholesaleMinQty: Int!
}

type Product {
  id: ID!
  barcode: String
  name: String!
  imageUrl: String
  categoryId: ID!
  unitId: ID!
  costPrice: Float!
  retailPrice: Float!
  wholesalePrice: Float!
  wholesaleMinQty: Int!
  stockQty: Float!
  minStockAlert: Float!
  status: String!
  packagingUnits: [PackagingUnit!]!
}

input NewProduct {
  barcode: String
  name: String!
  imageUrl: String
  categoryId: ID!
  unitId: ID!
  costPrice: Float!
  retailPrice: Float!
  wholesalePrice: Float!
  wholesaleMinQty: Int!
  stockQty: Float!
  minStockAlert: Float!
  packagingUnits: [PackagingUnitInput!]
}

input UpdateProduct {
  barcode: String
  name: String
  imageUrl: String
  categoryId: ID
  unitId: ID
  costPrice: Float
  retailPrice: Float
  wholesalePrice: Float
  wholesaleMinQty: Int
  stockQty: Float
  minStockAlert: Float
  status: String
  packagingUnits: [PackagingUnitInput!]
}

extend type Query {
  products: [Product!]!
  product(id: ID!): Product
}

extend type Mutation {
  createProduct(input: NewProduct!): Product!
  updateProduct(id: ID!, input: UpdateProduct!): Product!
  deleteProduct(id: ID!): Boolean!
}
