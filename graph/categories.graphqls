type Category {
  id: ID!
  name: String!
}

input NewCategory {
  name: String!
}

input UpdateCategory {
  name: String
}

extend type Query {
  categories: [Category!]!
  category(id: ID!): Category
}

extend type Mutation {
  createCategory(input: NewCategory!): Category!
  updateCategory(id: ID!, input: UpdateCategory!): Category!
  deleteCategory(id: ID!): Boolean!
}
